{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ftklein/guardiao-banksec-control/schemas/target.schema.json",
  "title": "Guardiao BankSec control plane target manifest",
  "description": "Declarative trust manifest for a single target repository. Two states are defined: BOOTSTRAP_PENDING (no trust granted) and ACTIVE (an explicitly approved commit plus an explicit trust surface).",
  "oneOf": [
    {
      "title": "BOOTSTRAP_PENDING",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "target", "statusContext", "trust"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "target": { "$ref": "#/definitions/target" },
        "statusContext": { "$ref": "#/definitions/statusContext" },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "approvedCommit", "trustedFiles"],
          "properties": {
            "state": { "const": "BOOTSTRAP_PENDING" },
            "approvedCommit": { "type": "null" },
            "trustedFiles": { "type": "array", "maxItems": 0, "items": { "$ref": "#/definitions/trustedFile" } }
          }
        }
      }
    },
    {
      "title": "ACTIVE",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "target", "statusContext", "trust"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "target": { "$ref": "#/definitions/target" },
        "statusContext": { "$ref": "#/definitions/statusContext" },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "approvedCommit", "trustedFiles"],
          "properties": {
            "state": { "const": "ACTIVE" },
            "approvedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "trustedFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/trustedFile" } }
          }
        }
      }
    }
  ],
  "definitions": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repository"],
      "properties": {
        "owner": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$" }
      }
    },
    "statusContext": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_.-]{0,99}$" },
    "trustedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "enum": [
            "security/banksec/security-cycle.sh",
            "security/banksec/ci-review.md",
            "security/banksec/baseline.md",
            "security/banksec/postgres-banksec-readonly.sql"
          ]
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
